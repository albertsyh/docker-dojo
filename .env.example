# Copy to .env for a real deployment. Locally, every value has a local-only default in
# compose.yaml, so `docker compose up` works on localhost without this file.
# compose.prod.yaml refuses to start unless every secret below is set.

# Production only: uncomment so every plain `docker compose ...` command on the server
# includes the prod overrides (no published ports, the tunnel, required secrets).
# COMPOSE_FILE=compose.yaml:compose.prod.yaml

APP_PORT=8000
APP_URL=https://dojo.example.com

# Signs quiz papers. Generate with: openssl rand -base64 32   (prefix with "base64:")
# Keep it stable: changing it invalidates any quiz a student has open.
APP_KEY=

# Only read when the database volume is first created. Set these before the first
# production start; changing DB_PASSWORD afterwards locks the api out (see README).
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Any random strings. The key is sent to browsers; the secret must stay private.
REVERB_APP_ID=dojo
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me

# New participants per minute per IP. A classroom usually shares one public IP.
DOJO_JOIN_PER_MINUTE=120

# Production only: the token of a Cloudflare Tunnel (Zero Trust > Networks > Tunnels,
# "Docker" connector). Its public hostname must point at http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=
